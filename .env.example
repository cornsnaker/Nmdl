# --- Required: get from https://my.telegram.org/apps -----------------------
API_ID=12345
API_HASH=0123456789abcdef0123456789abcdef
BOT_TOKEN=123456:ABC-DEF...

# --- Owner / auth ----------------------------------------------------------
# Numeric Telegram user id (open @userinfobot to find yours).
# Required for /auth, /unauth, /restart, /logs, /shell.
OWNER_ID=0
# JSON file storing authorized user ids (auto-created/updated by the bot).
AUTH_FILE=./auth_users.json

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=./bot.log
LOG_BUFFER=1000

# --- Runtime ---------------------------------------------------------------
SESSION_NAME=nmdl_bot
NMDL_BIN=N_m3u8DL-RE
FFMPEG_BIN=ffmpeg
DOWNLOAD_ROOT=./downloads

MAX_CONCURRENT=2
PAGE_SIZE=6
PROGRESS_INTERVAL=4.0
PROBE_TIMEOUT=60
PROBE_IDLE=3.0
DOWNLOAD_TIMEOUT=7200
SHELL_TIMEOUT=60
